{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,

    "noEmit": true,

    "types": [
      "node"
    ]
  },

  "include": [
    "api.ts",
    "bot.ts",
    "driveset-docs-bot.ts",
    "config.ts",
    "db.ts",
    "types.ts",
    "handlers/**/*.ts",
    "driveset/**/*.ts",
    "services/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "bot.ts.backup"
  ]
}
